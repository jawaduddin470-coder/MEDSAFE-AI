NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/medtech
JWT_SECRET=your_jwt_secret_123

# ── Gemini API Key Pool (Auto-Rotation) ────────────────────────────────────
# Add up to 10 Gemini keys. The server starts with KEY_1 and auto-rotates
# to the next key when any key hits a quota or rate-limit error.
# At least GEMINI_API_KEY_1 must be set. Others are optional but recommended.
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3
GEMINI_API_KEY_4=your_gemini_key_4
GEMINI_API_KEY_5=your_gemini_key_5
GEMINI_API_KEY_6=your_gemini_key_6
GEMINI_API_KEY_7=your_gemini_key_7
GEMINI_API_KEY_8=your_gemini_key_8
GEMINI_API_KEY_9=your_gemini_key_9
GEMINI_API_KEY_10=your_gemini_key_10

# ── OpenRouter (Diagnostics Hub) ───────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key

# Firebase Admin (Server-side)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key_string"

# Firebase Client-side (Vite)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key
